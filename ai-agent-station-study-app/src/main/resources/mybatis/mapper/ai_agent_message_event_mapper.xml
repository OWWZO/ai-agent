<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.wwz.ai.domain.agent.reactor.mapper.IAgentMessageEventDao">

    <resultMap id="AgentMessageEventMap" type="org.wwz.ai.domain.agent.reactor.entity.AgentMessageEvent">
        <id column="id" property="id"/>
        <result column="message_id" property="messageId"/>
        <result column="seq_no" property="seqNo"/>
        <result column="event_type" property="eventType"/>
        <result column="event_sub_type" property="eventSubType"/>
        <result column="display_area" property="displayArea"/>
        <result column="task_id" property="taskId"/>
        <result column="task_order" property="taskOrder"/>
        <result column="title" property="title"/>
        <result column="content_text" property="contentText"/>
        <result column="payload_json" property="payloadJson"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <insert id="batchInsert">
        INSERT INTO ai_agent_message_event (
            message_id, seq_no,
            event_type, event_sub_type, display_area, task_id, task_order,
            title, content_text, payload_json,
            status, create_time, deleted
        ) VALUES
        <foreach collection="events" item="item" separator=",">
            (
                #{item.messageId}, #{item.seqNo},
                #{item.eventType}, #{item.eventSubType}, #{item.displayArea}, #{item.taskId}, #{item.taskOrder},
                #{item.title}, #{item.contentText}, #{item.payloadJson},
                #{item.status}, now(), #{item.deleted}
            )
        </foreach>
    </insert>

    <select id="queryByMessageId" resultMap="AgentMessageEventMap">
        SELECT * FROM ai_agent_message_event
        WHERE message_id = #{messageId} AND deleted = 0
        ORDER BY seq_no ASC
    </select>

    <update id="deleteByMessageId">
        UPDATE ai_agent_message_event
        SET deleted = 1
        WHERE message_id = #{messageId} AND deleted = 0
    </update>

</mapper>
