
# ========== LLM 基础配置 ==========
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 敏感词过滤
SENSITIVE_WORD_REPLACE=true

LLM_TIMEOUT=600000
LLM_MAX_RETRIES=6
LLM_CONNECT_TIMEOUT=30
LLM_READ_TIMEOUT=600
LLM_WRITE_TIMEOUT=60
LLM_POOL_TIMEOUT=30

# 文件系统路径配置
FILE_SAVE_PATH=file_db_dir
SQLITE_DB_PATH=autobots.db
FILE_SERVER_URL=http://127.0.0.1:1601/v1/file_tool

# ========== 登录态只读平台（Cookie-Editor 导出；不要提交真实值） ==========
# Twitter adapter calls the installed `twitter` CLI with these values only in
# the child-process environment. It never reads browser cookies.
REACTOR_TWITTER_AUTH_TOKEN=
REACTOR_TWITTER_CT0=
# Optional command override for local installations; default is `twitter`.
# REACTOR_TWITTER_COMMAND=twitter
# Reddit uses the in-process read-only HTTP client, not rdt-cli.
REACTOR_REDDIT_SESSION=
# Xueqiu accepts a full Cookie header string, for example xq_a_token=...; xq_id_token=...
REACTOR_XUEQIU_COOKIE=

# ========== DeepSearch 配置 ==========
USE_JD_SEARCH_GATEWAY=false
USE_SEARCH_ENGINE=exa

DDG_REGION=wt-wt
DDG_SAFESEARCH=moderate
JINA_READER_TIMEOUT=15
# 可选：有更高速率需求再配
JINA_API_KEY=

# deepsearch专用模型配置
DEEPSEARCH_BASE_URL=
DEEPSEARCH_API_KEY=

SEARCH_COUNT=10
SEARCH_TIMEOUT=100000
SEARCH_THREAD_NUM=5
DEEPSEARCH_TOTAL_TIMEOUT_SECONDS=1200

DEFAULT_MODEL=

QUERY_DECOMPOSE_MODEL=
QUERY_DECOMPOSE_THINK_MODEL=
CHAPTER_SEARCH_PLAN_MODEL=
QUERY_DECOMPOSE_MAX_SIZE=2
SEARCH_REASONING_MODEL=
SEARCH_ANSWER_MODEL=
SEARCH_ANSWER_LENGTH=2500

SINGLE_PAGE_MAX_SIZE=6

# Exa Search
EXA_SEARCH_URL=https://api.exa.ai/search
EXA_API_KEY=

BING_SEARCH_URL=
BING_SEARCH_API_KEY=

JINA_SEARCH_URL=https://s.jina.ai/
JINA_SEARCH_API_KEY=

SOGOU_SEARCH_URL=
SOGOU_SEARCH_API_KEY=

SERPER_SEARCH_URL=https://google.serper.dev/search
SERPER_SEARCH_API_KEY=

# Code Interpreter 配置
CODE_INTEPRETER_MODEL=

# 代码执行云端沙箱
CODE_SANDBOX_BACKEND=e2b
E2B_API_KEY=

# 可选
E2B_TEMPLATE=reactor-code-playwright
# E2B_WORKDIR=/home/user/workspace
# E2B_TIMEOUT_SEC=600

# 进程拆分：api(1601, 多 worker) + sandbox(1602, workers=1)
# 本机 start-split.ps1 / 线上两个 systemd 使用；Java 仍只打 1601
# REACTOR_TOOL_ROLE=api
# REACTOR_SANDBOX_URL=http://127.0.0.1:1602
# REACTOR_TOOL_WORKERS=3
# E2B 直连，不走 HTTP_PROXY（apply_e2b_no_proxy 也会追加这些主机）
# NO_PROXY=127.0.0.1,localhost,::1,e2b.app,.e2b.app,e2b.dev,.e2b.dev

# ========== DataAgent 共享 ES / Qdrant 配置 ==========
# Python table_rag 只读取本文件中的 DATA_AGENT_*，不再回退系统环境变量或 TR_* 地址配置。
DATA_AGENT_ES_ENABLE=true
DATA_AGENT_ES_HOST=
DATA_AGENT_ES_SCHEME=https
DATA_AGENT_ES_USER=
DATA_AGENT_ES_PASSWORD=
DATA_AGENT_ES_API_KEY=

DATA_AGENT_QDRANT_ENABLE=true
DATA_AGENT_QDRANT_URL=
DATA_AGENT_QDRANT_HOST=
DATA_AGENT_QDRANT_PORT=6334
DATA_AGENT_QDRANT_API_KEY=
DATA_AGENT_QDRANT_PREFER_GRPC=true

# ========== table_rag 配置 ==========
# TR_QDRANT_URL 仍保留为外部向量召回 HTTP 服务地址；留空表示仅使用 DATA_AGENT_QDRANT_* 直连模式。
TR_QDRANT_URL=
TR_QDRANT_COLLECTION_NAME=reactor_model_schema
TR_QDRANT_LIMIT=30
TR_QDRANT_TIMEOUT=999999

TR_BUSINESS_PROMPT_MAX_LENGTH=3000
TR_SCHEMA_LIST_MAX_LENGTH=200
TR_USE_PROMPT_MAX_LENGTH=500

TR_EXTRACT_SYS_WSD_MODEL_NAME=${DEFAULT_MODEL}
TR_TABLE_FILTER_MODEL_NAME=${DEFAULT_MODEL}
TR_COLUMN_FILTER_MODEL_NAME=${DEFAULT_MODEL}

TR_IS_FIRST_FILTER_TABLE=true
TR_NEED_FILTER_TABLE_MIN_LENGTH=3
TR_TABLE_FILTER_BATCH_SIZE=5

TR_ES_CONFIGS_INDEX=reactor_model_column_value

# ES CONFIG
TR_ES_RECALL_TOP_K=15
TR_COLLECTION_NAME=

TR_QD_THRESHHOLD=0.4
TR_QD_RECALL_TOP_K=30
TR_QD_TIMEOUT=999999
TR_USE_RERANK=false
TR_BGE_RERANK_URL=
TR_RERANK_TOPK=5
TR_SCHEMA_TOPK=None
TR_MODEL_CODE_TOPK=None

# ========== cal engine 配置 ==========
CAL_ENGINE_MODEL=${DEFAULT_MODEL}

# ========== Analysis ==========
ANA_SCHEMA_URL=http://localhost:8100/data/queryModelInfo
ANA_DATA_URL=http://localhost:8100/data/apiChatQuery
ANALYSIS_MODEL=

# ========== NL2SQL ==========
NL2SQL_MODEL_NAME=
REWRITE_MODEL_NAME=
THINK_MODEL_NAME=




# ================MRAG分支=============
# LLM model (MRAG 回答生成专用，不填则复用 OPENAI_API_KEY / OPENAI_BASE_URL)
LLM_API_KEY=
LLM_MODEL_BASE_URL=
LLM_MODEL_NAME=

# VLM model (图片理解)
VLM_TYPE=openai
VLM_MODEL_BASE_URL=
VLM_API_KEY=
VLM_MODEL_NAME=

# text embedding model (文本向量化)
TEXT_EMBEDDING_TYPE=openai
TEXT_EMBEDDING_BASE_URL=
TEXT_EMBEDDING_API_KEY=
TEXT_EMBEDDING_MODEL_NAME=text-embedding-v4
TEXT_EMBEDDING_MAX_TEXT_LENGTH=8000
TEXT_EMBEDDING_DIMENSION=1024

# image index mode: multimodal=图片/页面直接入多模态向量库；text_proxy=只保留 OCR/caption 文本代理入文本向量库
MRAG_IMAGE_INDEX_MODE=text_proxy

# multimodal embedding model (图片向量化)
IMAGE_EMBEDDING_TYPE=dashscope
DASHSCOPE_MULTIMODAL_EMBEDDING_BASE_URL=
DASHSCOPE_MULTIMODAL_EMBEDDING_MODEL_NAME=
DASHSCOPE_API_KEY=
IMAGE_EMBEDDING_DIMENSION=1024

# OCR model (文档解析: vlm-ocr 或 deepseek-ocr)
OCR_TYPE=vlm-ocr
DEEPSEEK_OCR_BASE_URL=
DEEPSEEK_OCR_API_KEY=
DEEPSEEK_OCR_MODEL_NAME=

OCR_TYPE=paddleocr-vl
PADDLE_OCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLE_OCR_TOKEN=
PADDLE_OCR_MODEL_NAME=PaddleOCR-VL-1.6

# PDF 页面渲染（pdf2image 依赖的 poppler；留空时优先走 PATH，再尝试自动探测）
POPPLER_PATH=

# text reranker model (检索重排序)
ENABLE_RERANKER=true
TEXT_RERANKER_TYPE=api
TEXT_RERANKER_BASE_URL=
TEXT_RERANKER_API_KEY=
TEXT_RERANKER_MODEL_NAME=qwen3-rerank

# MinerU (PDF 文档解析服务)
MINERU_BASE_URL=https://mineru.net/api/v4/extract/task
MINERU_API_KEY=
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_UPLOAD_MODE=mineru_managed
# ≤该页数整文件一次提交；超过后按 PDF_CHUNK_SIZE 页切块
SMALL_PDF_PAGE_THRESHOLD=25
PDF_CHUNK_SIZE=25

# text split (文本切分策略)
CHUNK_TYPE=markdown
CHUNK_SIZE=500
CHUNK_OVERLAP=100
ENABLE_SUB_CHUNK_ENHANCE=true
SUB_CHUNK_SIZE=100

# retrieval thresholds (检索相似度阈值)
RETRIEVAL_TEXT_THRESHOLD=0.7
RETRIEVAL_IMAGE_THRESHOLD=0.6
RETRIEVAL_PAGE_THRESHOLD=0.35

# storage (向量存储)
VECTOR_STORE_TYPE=qdrant
QDRANT_URL=
QDRANT_PORT=6334
QDRANT_API_KEY=

# metadata storage (元数据存储)
STORE_TYPE=sqlite
SQLITE_PATH=/tmp/mrag_sqlite.db

# default knowledge base
DEFAULT_KB_ID=

# Qdrant collection names
TEXT_COLLECTION=t_reactor_mrag_text_vectors
IMAGE_COLLECTION=t_reactor_mrag_image_vectors
PAGE_COLLECTION=t_reactor_mrag_page_vectors

# object storage (文档原始文件存储)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_DIR=mrag
OSS_SERVER_BASE_URL=http://127.0.0.1:8000/storage

API_TIMEOUT=300

# LightRAG (可选替代方案)
ENABLE_LIGHT_RAG=
LIGHTRAG_SERVER_BASE_URL=
# ================MRAG END =============
REACTOR_TWITTER_PROXY=http://127.0.0.1:7890
REACTOR_REDDIT_PROXY=http://127.0.0.1:7890
REACTOR_WEB_FETCH_PROXY=http://127.0.0.1:7890
